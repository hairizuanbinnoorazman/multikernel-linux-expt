{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multikernel.example/schemas/daemon-protocol-v1.schema.json",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "request_id", "method"],
      "properties": {
        "version": {"const": 1},
        "request_id": {"$ref": "#/$defs/requestId"},
        "method": {"enum": ["NodeInfo", "ListSandboxes", "CreateSandbox", "CancelCreateSandbox", "LoadSandbox", "StartSandbox", "StopSandbox", "DeleteSandbox", "SandboxState", "WatchEvents"]},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -~]+$"},
        "sandbox_id": {"$ref": "#/$defs/sandboxId"},
        "generation": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "body": {"type": "object"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "request_id"],
      "properties": {"version": {"const": 1}, "request_id": {"$ref": "#/$defs/requestId"}, "body": {}, "error": {"$ref": "#/$defs/error"}},
      "oneOf": [{"required": ["body"], "not": {"required": ["error"]}}, {"required": ["error"], "not": {"required": ["body"]}}]
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "operation_id", "retryable"],
      "properties": {
        "code": {"enum": ["INVALID_ARGUMENT", "UNSUPPORTED", "NOT_FOUND", "ALREADY_EXISTS", "STALE_GENERATION", "IDEMPOTENCY_CONFLICT", "FAILED_PRECONDITION", "RESOURCE_EXHAUSTED", "BACKEND_TIMEOUT", "BACKEND_FAILURE", "UNAUTHENTICATED", "ABORTED", "OPERATOR_ACTION", "INTERNAL"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024},
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "retryable": {"type": "boolean"}
      }
    },
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -~]+$"},
    "sandboxId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}
  }
}
