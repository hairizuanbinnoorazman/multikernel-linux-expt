#!/bin/busybox sh

/bin/busybox --install -s /bin
mkdir -p /dev /proc /sys /tmp /newroot
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

getarg() {
    for arg in $(cat /proc/cmdline); do
        case "$arg" in
            "$1"=*) echo "${arg#*=}"; return ;;
        esac
    done
}

child=$(getarg mk.child)
image_id=$(getarg mk.image_id)
generation=$(getarg mk.generation)
root_uuid=$(getarg mk.root_uuid)
port=$(getarg mk.port)
size=$(getarg mk.size)

echo "MEDIATED_ROOT_BOOTSTRAP_BEGIN child=$child image_id=$image_id generation=$generation uuid=$root_uuid"
for value in "$child" "$image_id" "$generation" "$root_uuid" "$port" "$size"; do
    if [ -z "$value" ]; then
        echo "MEDIATED_ROOT_BOOTSTRAP_FAIL reason=missing-argument"
        exec sh
    fi
done

insmod /lib/mk_transport.ko || {
    echo "MEDIATED_ROOT_BOOTSTRAP_FAIL reason=transport-module"
    exec sh
}
insmod /lib/nbd.ko nbds_max=2 || {
    echo "MEDIATED_ROOT_BOOTSTRAP_FAIL reason=nbd-module"
    exec sh
}
ip link set lo up || {
    echo "MEDIATED_ROOT_BOOTSTRAP_FAIL reason=loopback"
    exec sh
}

/bin/mkvsock-nbd client 0 "$port" /dev/nbd0 "$size" "$image_id" "$generation" reserved \
    >/tmp/nbd-client.log 2>&1 &
nbd_pid=$!
ready=0
for second in $(seq 1 15); do
    if [ -b /dev/nbd0 ] && [ "$(cat /sys/class/block/nbd0/size 2>/dev/null)" -gt 0 ]; then
        ready=1
        break
    fi
    kill -0 "$nbd_pid" 2>/dev/null || break
    sleep 1
done
cat /tmp/nbd-client.log
if [ "$ready" -ne 1 ]; then
    echo "MEDIATED_ROOT_BOOTSTRAP_FAIL reason=nbd-timeout"
    exec sh
fi

observed_uuid=
for second in $(seq 1 15); do
    observed_uuid=$(/bin/mkvsock-nbd uuid /dev/nbd0 2>/dev/null) && break
    kill -0 "$nbd_pid" 2>/dev/null || break
    sleep 1
done
if [ "$observed_uuid" != "$root_uuid" ]; then
    echo "MEDIATED_ROOT_BOOTSTRAP_FAIL reason=uuid expected=$root_uuid observed=$observed_uuid"
    exec sh
fi
if ! mount -t ext4 -o rw /dev/nbd0 /newroot; then
    echo "MEDIATED_ROOT_BOOTSTRAP_FAIL reason=mount"
    exec sh
fi
observed_child=$(cat /newroot/etc/mk-child-id 2>/dev/null)
if [ "$observed_child" != "$child" ]; then
    echo "MEDIATED_ROOT_BOOTSTRAP_FAIL reason=identity expected=$child observed=$observed_child"
    umount /newroot
    exec sh
fi

echo "MEDIATED_ROOT_BOOTSTRAP_PASS device=/dev/nbd0 uuid=$observed_uuid child=$child"
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
exec switch_root /newroot /init
