#!/bin/busybox sh
set -eu
/bin/busybox --install -s /bin
mkdir -p /dev /dev/pts /dev/shm /dev/mqueue /proc /sys /sys/fs/cgroup /run /tmp
is_mounted() {
	/bin/busybox grep -qs " $1 " /proc/mounts 2>/dev/null
}
is_mounted /dev || /bin/busybox mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /dev/mqueue
is_mounted /dev/pts || /bin/busybox mount -t devpts devpts /dev/pts -o mode=620,ptmxmode=666
is_mounted /dev/shm || /bin/busybox mount -t tmpfs shm /dev/shm -o nosuid,noexec,nodev,mode=1777,size=65536k
is_mounted /dev/mqueue || /bin/busybox mount -t mqueue mqueue /dev/mqueue -o nosuid,noexec,nodev
is_mounted /proc || /bin/busybox mount -t proc proc /proc
is_mounted /sys || /bin/busybox mount -t sysfs sysfs /sys
is_mounted /sys/fs/cgroup || /bin/busybox mount -t cgroup2 none /sys/fs/cgroup
mkdir -p /bundle/rootfs/dev /bundle/rootfs/proc /bundle/rootfs/sys /bundle/rootfs/run /bundle/rootfs/tmp
# Export ordinary workload devices, keeping bootstrap disks and privileged
# memory, I/O and kernel-log interfaces out of the workload device tree.
mount -t tmpfs -o nosuid,noexec,mode=755,size=16384k tmpfs /bundle/rootfs/dev
for device in 'null 1 3' 'zero 1 5' 'full 1 7' 'random 1 8' 'urandom 1 9' 'tty 5 0'; do
	set -- $device
	mknod -m 666 "/bundle/rootfs/dev/$1" c "$2" "$3"
done
mkdir -p /bundle/rootfs/dev/pts /bundle/rootfs/dev/shm /bundle/rootfs/dev/mqueue
mount --bind /dev/pts /bundle/rootfs/dev/pts
mount --bind /dev/shm /bundle/rootfs/dev/shm
mount --bind /dev/mqueue /bundle/rootfs/dev/mqueue
ln -s pts/ptmx /bundle/rootfs/dev/ptmx
ln -s /proc/self/fd /bundle/rootfs/dev/fd
ln -s /proc/self/fd/0 /bundle/rootfs/dev/stdin
ln -s /proc/self/fd/1 /bundle/rootfs/dev/stdout
ln -s /proc/self/fd/2 /bundle/rootfs/dev/stderr
mount --bind /proc /bundle/rootfs/proc
mount --bind /sys /bundle/rootfs/sys
mount -o remount,bind,nosuid,noexec,nodev /bundle/rootfs/proc
mount -o remount,bind,ro,nosuid,noexec,nodev /bundle/rootfs/sys
mount -t tmpfs tmpfs /bundle/rootfs/run -o nosuid,strictatime,mode=755,size=65536k
if [ -f /mk_transport.ko ] && ! grep -q '^mk_transport ' /proc/modules; then
	insmod /mk_transport.ko
fi

sandbox_id=
generation=
port=
for arg in $(cat /proc/cmdline); do
	case "$arg" in
		mk.sandbox_id=*) sandbox_id=${arg#*=} ;;
		mk.generation=*) generation=${arg#*=} ;;
		mk.token=*) echo MK_AGENT_INSECURE_BOOT_CREDENTIAL; exit 1 ;;
		mk.agent_port=*) port=${arg#*=} ;;
	esac
done

if [ -z "$sandbox_id" ] || [ -z "$generation" ] || [ ! -f /.mk-agent/token ] || [ -z "$port" ]; then
	echo MK_AGENT_BOOT_CONFIG_MISSING
	exec sh -c 'while true; do sleep 3600; done'
fi

docker_guest=
profile_marker=/.multikernel/docker-guest
if [ -e "$profile_marker" ] || [ -L "$profile_marker" ]; then
    test -f "$profile_marker" && test ! -L "$profile_marker"
    test "$(stat -c '%u:%a:%h:%s' "$profile_marker")" = '0:600:1:27'
    test "$(cat "$profile_marker")" = docker-rootless-offline-v1
    for component in llc stp bridge veth; do
        artifact=/bootstrap-modules/$component.ko
        test -f "$artifact" && test ! -L "$artifact"
        test "$(stat -c '%u:%a:%h' "$artifact")" = '0:644:1'
        insmod "$artifact"
    done
    docker_guest=--docker-guest
fi

echo "MK_AGENT_START sandbox=$sandbox_id generation=$generation port=$port"
mediated=
grep -q 'mk.storage_generation=' /proc/cmdline && mediated=--mediated-root
agent_socket_dir=/run/multikernel-agent
agent_socket=$agent_socket_dir/control.sock
mkdir -p "$agent_socket_dir"
chmod 0700 "$agent_socket_dir"
/mk-agent --sandbox-id="$sandbox_id" --generation="$generation" \
	--token-file=/.mk-agent/token --port="$port" --unix-socket="$agent_socket" $mediated $docker_guest &
agent_pid=$!
while kill -0 "$agent_pid" 2>/dev/null; do
	# The agent publishes this protected listener only after service readiness.
	# Do not establish a primary relay session while Docker is still starting.
	if [ ! -S "$agent_socket" ]; then
		sleep 0.1
		continue
	fi
	/mkvsock-relay client 0 "$port" "$agent_socket" || true
	kill -0 "$agent_pid" 2>/dev/null || break
	sleep 1
done
wait "$agent_pid" || true
# At pinned commit 3bdd35b6, a spawn kernel replaces machine poweroff/restart
# with mk_halt_to_pool(). A successful authenticated Shutdown therefore never
# returns here: it syncs, notifies the primary, and parks only this child's CPUs.
# Remain recoverable if the agent exits without completing that path.
echo MK_AGENT_EXITED_WITHOUT_POWEROFF
exec sh -c 'while true; do sleep 3600; done'
