#!/bin/sh
# Client for the guest-local builder; no primary Docker socket is used.
set -eu
case "${1:-}" in -h|--help)
    echo 'usage: mk-build [CONTEXT_DIRECTORY [OUTPUT_OCI_TAR]]'
    exit 0
esac
[ "$#" -le 2 ] || { echo 'usage: mk-build [CONTEXT_DIRECTORY [OUTPUT_OCI_TAR]]' >&2; exit 2; }
context=${1:-.}
output=${2:-image.tar}
[ -d "$context" ] && [ -f "$context/Dockerfile" ] || {
    echo 'context must contain a Dockerfile' >&2; exit 2;
}
case "$output" in /*) ;; *) output="$PWD/$output" ;; esac
case "$output" in *,*) echo 'output path cannot contain a comma' >&2; exit 2 ;; esac
exec buildctl --addr unix:///run/buildkit/buildkitd.sock build \
    --frontend dockerfile.v0 --local "context=$context" --local "dockerfile=$context" \
    --output "type=oci,dest=$output"
