+/* Legacy error-cleanup callers cannot return an unload result. */
+void kimage_free(struct kimage *image)
+{
+	int ret = kimage_free_checked(image);
+
+	if (ret)
+		pr_err("Multikernel image cleanup retained resources: %d\n", ret);
+}
+
+/* Called with the kexec operation lock held. Failures leave the image listed.
+ * A fixed work budget prevents an unbounded privileged syscall; E2BIG means
+ * partial progress and the caller may explicitly retry the remaining images.
+ */
+int kimage_unload_multikernels(void)
+{
+	struct kimage *image;
+	unsigned int unloaded;
+	int ret;
+
+	for (unloaded = 0; unloaded < 128; unloaded++) {
+		image = kimage_find_by_type(KEXEC_TYPE_MULTIKERNEL);
+		if (!image)
+			return 0;
+		ret = kimage_free_checked(image);
+		if (ret)
+			return ret;
+	}
+	return kimage_find_by_type(KEXEC_TYPE_MULTIKERNEL) ? -E2BIG : 0;
 }
 
