+/* Last-reference failures retain the complete allocation and ownership metadata.
+ * These records have no kref users; only this registry may inspect them.
+ */
+static LIST_HEAD(mk_retained_instances);
+static DEFINE_SPINLOCK(mk_retained_instances_lock);
+
+static void mk_instance_retain(struct mk_instance *instance, int error)
+{
+	unsigned long flags;
+
+	instance->release_error = error;
+	spin_lock_irqsave(&mk_retained_instances_lock, flags);
+	list_add_tail(&instance->retained_list, &mk_retained_instances);
+	spin_unlock_irqrestore(&mk_retained_instances_lock, flags);
+	pr_err("Retained instance %d generation %llu after unsafe release: %d\n",
+	       instance->id, instance->generation, error);
+}
+
+int mk_retained_instances_show(struct seq_file *sf, void *v)
+{
+	struct mk_instance *instance;
+	unsigned long flags;
+
+	spin_lock_irqsave(&mk_retained_instances_lock, flags);
+	list_for_each_entry(instance, &mk_retained_instances, retained_list)
+		seq_printf(sf, "id=%d generation=%llu error=%d cpus=%u regions=%d\n",
+			   instance->id, instance->generation, instance->release_error,
+			   mk_cpu_set_count(instance->cpus), instance->region_count);
+	spin_unlock_irqrestore(&mk_retained_instances_lock, flags);
+	return 0;
+}
