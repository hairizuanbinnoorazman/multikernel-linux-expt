+/* Only for unpublished boot objects: copied resource descriptions were never
+ * transferred from root, and mapped rings must not be freed as owned pages.
+ */
+static void __init mk_free_private_instance(struct mk_instance *instance,
+					  bool allocated_ipi)
+{
+	struct mk_pci_device *pci, *pci_tmp;
+	struct mk_platform_device *platform, *platform_tmp;
+
+	list_for_each_entry_safe(pci, pci_tmp, &instance->pci_devices, list) {
+		list_del(&pci->list);
+		kfree(pci);
+	}
+	list_for_each_entry_safe(platform, platform_tmp,
+				 &instance->platform_devices, list) {
+		list_del(&platform->list);
+		kfree(platform);
+	}
+	if (instance->ipi_data) {
+		if (allocated_ipi)
+			free_pages((unsigned long)instance->ipi_data,
+				   get_order(sizeof(struct mk_shared_data)));
+		else
+			memunmap(instance->ipi_data);
+	}
+	mk_cpu_set_free(instance->cpus);
+	kfree(instance->dtb_data);
+	kfree(instance->name);
+	kfree(instance);
+}
+
+static int __init mk_publish_boot_instance(struct mk_instance *instance,
+					  bool is_root)
+{
+	int ret;
+
+	mutex_lock(&mk_instance_mutex);
+	ret = idr_alloc(&mk_instance_idr, instance, instance->id,
+			instance->id + 1, GFP_KERNEL);
+	if (ret >= 0) {
+		list_add(&instance->list, &mk_instance_list);
+		if (is_root)
+			root_instance = instance;
+	}
+	mutex_unlock(&mk_instance_mutex);
+	return ret < 0 ? ret : 0;
+}
