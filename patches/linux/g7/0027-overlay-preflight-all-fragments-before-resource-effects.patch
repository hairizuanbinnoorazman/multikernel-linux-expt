+/* Validate the complete input before any earlier fragment can move resources.
+ * This descriptor owns no ledger or resource state; validation must not resolve
+ * live instance identity, reserve resources or publish instance/transaction files.
+ */
+static int mk_overlay_preflight_fragments(struct mk_overlay_tx *tx,
+					  const void *fdt,
+					  const struct mk_overlay_fragment *frags,
+					  int nr)
+{
+	struct mk_overlay_tx validation = {
+		.id = tx->id,
+		.dtbo_size = tx->dtbo_size,
+		.validate_only = true,
+	};
+	struct mk_overlay_target target;
+	int fragment, overlay_node, op, ret;
+
+	for (fragment = 0; fragment < nr; fragment++) {
+		ret = mk_overlay_resolve_target(&validation, fdt,
+						frags[fragment].node, &target);
+		if (ret)
+			return ret;
+		overlay_node = mk_overlay_fragment_overlay_node(&validation, fdt,
+							frags[fragment].node,
+							&target);
+		if (overlay_node < 0)
+			return -EINVAL;
+		for (op = 0; op < MK_OVERLAY_OP_COUNT; op++) {
+			ret = mk_overlay_run_op(&validation, fdt, overlay_node,
+						&target, op, false);
+			if (ret)
+				return ret;
+		}
+	}
+
+	return 0;
+}
