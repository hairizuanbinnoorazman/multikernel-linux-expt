+/* A property is not a C string until its own extent proves one value. */
+static int mk_overlay_get_string(const void *fdt, int node,
+				 const char *property, const char **value)
+{
+	const char *prop;
+	int len;
+
+	prop = fdt_getprop(fdt, node, property, &len);
+	if (!prop)
+		return len == -FDT_ERR_NOTFOUND ? -ENOENT : -EINVAL;
+	if (len < 1 || prop[len - 1] != '\0' ||
+	    strnlen(prop, len) != (size_t)len - 1)
+		return -EINVAL;
+
+	*value = prop;
+	return 0;
+}
