+/* Device properties are single, nonempty strings, not string lists. */
+static int mk_baseline_get_string(const void *fdt, int node,
+				  const char *name, const char **value)
+{
+	const char *prop;
+	int len;
+
+	prop = fdt_getprop(fdt, node, name, &len);
+	if (!prop)
+		return len == -FDT_ERR_NOTFOUND ? -ENOENT : -EINVAL;
+	if (len <= 1 || prop[len - 1] != '\0' ||
+	    strnlen(prop, len) != (size_t)len - 1)
+		return -EINVAL;
+
+	*value = prop;
+	return 0;
+}
+
+static int mk_baseline_parse_pci_id(const char *value, unsigned int *domain,
+				    unsigned int *bus, unsigned int *slot,
+				    unsigned int *func)
+{
+	int i, consumed = 0;
+
+	for (i = 0; value[i]; i++)
+		if (!isxdigit(value[i]) && value[i] != ':' && value[i] != '.')
+			return -EINVAL;
+
+	if (sscanf(value, "%4x:%2x:%2x.%1x%n", domain, bus, slot, func,
+		   &consumed) != 4 || value[consumed] ||
+	    *domain > 0xffff || *bus > 0xff || *slot > 0x1f || *func > 7)
+		return -EINVAL;
+	return 0;
+}
