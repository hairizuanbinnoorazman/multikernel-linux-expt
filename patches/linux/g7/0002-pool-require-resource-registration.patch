--- a/kernel/multikernel/mem.c
+++ b/kernel/multikernel/mem.c
@@ -602,12 +602,15 @@
 		ret = -ENOMEM;
 		goto err_unlock;
 	}
-	ret = gen_pool_add(pool, chunk->res.start, size, chunk->node);
+	/* Resource ownership must be visible before allocator publication. */
+	ret = insert_resource(&iomem_resource, &chunk->res);
 	if (ret)
 		goto err_unlock;
