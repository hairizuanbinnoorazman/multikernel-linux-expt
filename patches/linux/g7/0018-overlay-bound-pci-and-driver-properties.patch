+static int mk_overlay_parse_driver(const void *fdt, int item_node,
+				   const char **driver)
+{
+	const char *prop;
+	int len;
+
+	prop = fdt_getprop(fdt, item_node, "driver", &len);
+	if (!prop) {
+		if (len != -FDT_ERR_NOTFOUND)
+			return -EINVAL;
+		*driver = NULL;
+		return 0;
+	}
+	if (len < 1 ||
+	    len > (int)sizeof_field(struct mk_device_resource_payload, driver_override) ||
+	    prop[len - 1] != '\0' || strnlen(prop, len) != (size_t)len - 1)
+		return -EINVAL;
+
+	*driver = prop;
 	return 0;
 }
 
