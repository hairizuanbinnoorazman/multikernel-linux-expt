 #include <linux/vmalloc.h>
 #include "internal.h"
 
+/* Serializes assignable-set validation, allocation and ownership publication.
+ * Physical hotplug and arch park waits execute outside this mutex.
+ */
+DEFINE_MUTEX(mk_cpu_ownership_mutex);
+struct mk_cpu_pool_transition {
+	struct list_head list;
+	mk_phys_cpu_t cpu;
+	bool from_pool;
+	bool finished;
+	int error;
+};
+static LIST_HEAD(mk_cpu_pool_transitions);
+
+bool mk_cpu_pool_cpu_busy(mk_phys_cpu_t cpu)
+{
+	struct mk_cpu_pool_transition *op;
+
+	lockdep_assert_held(&mk_cpu_ownership_mutex);
+	list_for_each_entry(op, &mk_cpu_pool_transitions, list)
+		if (op->cpu == cpu)
+			return true;
+	return false;
+}
+
+int mk_cpu_pool_copy_busy(struct mk_cpu_set *out)
+{
+	struct mk_cpu_pool_transition *op;
+	int ret;
+
+	lockdep_assert_held(&mk_cpu_ownership_mutex);
+	list_for_each_entry(op, &mk_cpu_pool_transitions, list) {
+		ret = mk_cpu_set_add(out, op->cpu);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+int mk_cpu_pool_begin(mk_phys_cpu_t cpu, bool from_pool)
+{
+	struct mk_cpu_pool_transition *op;
+	int ret = 0;
+
+	op = kzalloc(sizeof(*op), GFP_KERNEL);
+	if (!op)
+		return -ENOMEM;
+	mutex_lock(&mk_cpu_ownership_mutex);
+	if (!mk_cpu_pool || !root_instance || !root_instance->cpus) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (mk_cpu_pool_cpu_busy(cpu) ||
+	    mk_cpu_set_contains(mk_cpu_pool, cpu) != from_pool ||
+	    mk_cpu_set_contains(root_instance->cpus, cpu) == from_pool) {
+		ret = -EBUSY;
+		goto out;
+	}
+	op->cpu = cpu;
+	op->from_pool = from_pool;
+	list_add_tail(&op->list, &mk_cpu_pool_transitions);
+	if (from_pool)
+		mk_cpu_set_del(mk_cpu_pool, cpu);
+out:
+	mutex_unlock(&mk_cpu_ownership_mutex);
+	if (ret)
+		kfree(op);
+	return ret;
+}
+
+int mk_cpu_pool_finish(mk_phys_cpu_t cpu, bool from_pool, int error)
+{
+	struct mk_cpu_pool_transition *op;
+	int ret = error;
+
+	guard(mutex)(&mk_cpu_ownership_mutex);
+	list_for_each_entry(op, &mk_cpu_pool_transitions, list) {
+		if (op->cpu != cpu)
+			continue;
+		if (op->finished || op->from_pool != from_pool)
+			return -EUCLEAN;
+		if (!ret && mk_cpu_set_contains(root_instance->cpus, cpu) != from_pool)
+			ret = -EUCLEAN;
+		if (!ret && !from_pool)
+			ret = mk_cpu_set_add(mk_cpu_pool, cpu);
+		if (ret) {
+			op->finished = true;
+			op->error = ret;
+			pr_err("Retained CPU %llu pool transition from_pool=%d error=%d\n",
+			       cpu, from_pool, ret);
+			return -EUCLEAN;
+		}
+		list_del(&op->list);
+		kfree(op);
+		return 0;
+	}
+	return -ENOENT;
+}
+
+int mk_cpu_pool_transitions_show(struct seq_file *sf, void *v)
+{
+	struct mk_cpu_pool_transition *op;
+	unsigned int rows = 0;
+
+	guard(mutex)(&mk_cpu_ownership_mutex);
+	list_for_each_entry(op, &mk_cpu_pool_transitions, list) {
+		if (rows++ == 64) {
+			seq_puts(sf, "truncated=1 limit=64\n");
+			break;
+		}
+		seq_printf(sf, "cpu=%llu direction=%s state=%s error=%d\n",
+			   op->cpu, op->from_pool ? "pool-to-host" : "host-to-pool",
+			   op->finished ? "reconciliation-required" : "in-progress", op->error);
+	}
+	return 0;
+}
