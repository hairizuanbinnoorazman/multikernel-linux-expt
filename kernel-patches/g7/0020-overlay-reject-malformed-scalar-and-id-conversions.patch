+	const fdt32_t *prop;
+	u32 value;
+	int len;
+
+	prop = fdt_getprop(fdt, op_node, "id", &len);
+	if (!prop) {
+		if (len != -FDT_ERR_NOTFOUND)
+			return -EINVAL;
+		*id = -1;
+		return 0;
+	}
+	if (len != (int)sizeof(*prop))
+		return -EINVAL;
