+/* Property bytes are not C strings until their own length proves it. */
+static int mk_dt_get_device_string(const void *fdt, int node,
+				   const char *name, const char **value)
+{
+	const char *prop;
+	int len;
+
+	prop = fdt_getprop(fdt, node, name, &len);
+	if (!prop)
+		return len == -FDT_ERR_NOTFOUND ? -ENOENT : -EINVAL;
+	if (len <= 1 || prop[len - 1] != '\0' ||
+	    strnlen(prop, len) != (size_t)len - 1)
+		return -EINVAL;
+	*value = prop;
+	return 0;
+}
+
+static int mk_dt_parse_pci_address(const char *value, unsigned int *domain,
+				   unsigned int *bus, unsigned int *slot,
+				   unsigned int *func)
+{
+	int i, consumed = 0;
+
+	if (strlen(value) >= sizeof("ffff:ff:1f.7"))
+		return -EINVAL;
+	for (i = 0; value[i]; i++)
+		if (!isxdigit(value[i]) && value[i] != ':' && value[i] != '.')
+			return -EINVAL;
+	if (sscanf(value, "%4x:%2x:%2x.%1x%n", domain, bus, slot, func,
+		   &consumed) != 4 || value[consumed] ||
+	    *domain > 0xffff || *bus > 0xff || *slot > 0x1f || *func > 7)
+		return -EINVAL;
+	return 0;
+}
+
+/* Preflight the entire list before resolving or appending any device. */
+static int mk_dt_validate_device_names(const char *data, int len, size_t max_name)
+{
+	const char *name = data, *end;
+	int remaining = len;
+	size_t size;
+
+	if (len < 0)
+		return -EINVAL;
+	while (remaining) {
+		end = memchr(name, '\0', remaining);
+		if (!end)
+			return -EINVAL;
+		size = end - name;
+		if (!size || size > max_name || memchr(name, '/', size) ||
+		    (size == 1 && name[0] == '.') ||
+		    (size == 2 && name[0] == '.' && name[1] == '.'))
+			return -EINVAL;
+		remaining -= size + 1;
+		name = end + 1;
+	}
+	return 0;
+}
