+/* Shared by boot restore and runtime creation; never wrap or reuse tokens. */
+static atomic64_t mk_instance_next_generation = ATOMIC64_INIT(0);
+
+int mk_instance_assign_generation(struct mk_instance *instance)
+{
+	s64 generation = atomic64_read(&mk_instance_next_generation);
+
+	if (instance->generation)
+		return -EALREADY;
+	for (;;) {
+		if (generation == S64_MAX)
+			return -EOVERFLOW;
+		if (atomic64_try_cmpxchg(&mk_instance_next_generation, &generation,
+					 generation + 1))
+			break;
+	}
+	instance->generation = (u64)generation + 1;
+	return 0;
+}
 
