+/* The producer exposes exactly the page-rounded shared-ring ABI. Validate
+ * scalar ranges before narrowing or mapping; physical ownership is a separate
+ * trust requirement of the boot handoff, not established by these bounds.
+ */
+static int __init mk_manifest_get_ipi_range(const void *manifest,
+					 const char *node_name,
+					 phys_addr_t *physical, u32 *pages,
+					 size_t *size)
+{
+	const fdt64_t *phys_prop;
+	const fdt32_t *pages_prop;
+	size_t expected_size = PAGE_ALIGN(sizeof(struct mk_shared_data));
+	u64 address;
+	u32 count;
+	int node, len;
+
+	node = fdt_subnode_offset(manifest, 0, node_name);
+	if (node == -FDT_ERR_NOTFOUND)
+		return -ENOENT;
+	if (node < 0)
+		return -EINVAL;
+
+	phys_prop = fdt_getprop(manifest, node, "phys-addr", &len);
+	if (!phys_prop || len != sizeof(*phys_prop))
+		return -EINVAL;
+	address = fdt64_ld(phys_prop);
+	pages_prop = fdt_getprop(manifest, node, "pages", &len);
+	if (!pages_prop || len != sizeof(*pages_prop))
+		return -EINVAL;
+	count = fdt32_ld(pages_prop);
+
+	if (!address || (address & (PAGE_SIZE - 1)) ||
+	    (u64)(phys_addr_t)address != address ||
+	    count != expected_size >> PAGE_SHIFT ||
+	    address > PHYS_ADDR_MAX - (expected_size - 1))
+		return -EINVAL;
+
+	*physical = (phys_addr_t)address;
+	*pages = count;
+	*size = expected_size;
+	return 0;
+}
+
+/* Preflight both declarations before CPU registration or restore allocation. */
+static int __init mk_manifest_validate_ipi_ranges(const void *manifest)
+{
+	phys_addr_t own_phys, host_phys;
+	u32 own_pages, host_pages;
+	size_t own_size, host_size;
+	int own, host;
+
+	own = mk_manifest_get_ipi_range(manifest, "ipi-buffer", &own_phys,
+				       &own_pages, &own_size);
+	if (own && own != -ENOENT)
+		return own;
+	host = mk_manifest_get_ipi_range(manifest, "host-ipi-buffer", &host_phys,
+					&host_pages, &host_size);
+	if (host && host != -ENOENT)
+		return host;
+	if (!own && !host && own_phys <= host_phys + host_size - 1 &&
+	    host_phys <= own_phys + own_size - 1)
+		return -EINVAL;
+	return 0;
+}
