# /etc/systemd/system/mkruntimed.service -> /etc/multikernel/deployments/6182145c5cef6f7ebc12546387a65572656eb204c99e0f3d42534f6189b4380a/systemd/mkruntimed.service
[Unit]
Description=Multikernel container runtime control plane
Requires=sys-fs-multikernel.mount
# Host qualification requires the GCE guest agent to be active. Order the
# first daemon start after its Type=notify readiness instead of consuming a
# predictable Restart=on-failure cycle during boot.
Requires=google-guest-agent.service
After=local-fs.target sys-fs-multikernel.mount google-guest-agent.service
Before=containerd.service docker.service
RequiresMountsFor=/srv/multikernel-storage

[Service]
Type=simple
EnvironmentFile=/etc/multikernel/runtime.env
ExecStartPre=/sbin/modprobe vsock
ExecStartPre=-/sbin/insmod /usr/local/libexec/multikernel/mk_transport.ko
ExecStartPre=/usr/bin/test -d /sys/module/mk_transport
ExecStartPre=/usr/local/libexec/multikernel/validate-runtime-storage-mount.py --mountpoint ${MKRUNTIME_STORAGE_MOUNT} --device ${MKRUNTIME_STORAGE_DEVICE} --serial ${MKRUNTIME_STORAGE_SERIAL} --bytes ${MKRUNTIME_STORAGE_BYTES} --label ${MKRUNTIME_STORAGE_LABEL} --uuid ${MKRUNTIME_STORAGE_UUID}
ExecStart=/usr/local/sbin/mkruntimed --config=/etc/mkruntime/config.json --pool-cpus=${MKRUNTIME_POOL_CPUS} --pool-memory=${MKRUNTIME_POOL_MEMORY} --pool-memory-reserve=${MKRUNTIME_POOL_MEMORY_RESERVE} --storage-state-dir=/var/lib/mkruntimed/storage --storage-runtime-dir=/run/mkstorage --storage-server=/usr/local/libexec/multikernel/mkvsock-nbd --rootfs-state-dir=/var/lib/mkruntimed/rootfs --rootfs-storage-dir=/srv/multikernel-storage/runtime --rootfs-builder=/usr/local/libexec/multikernel/build-runtime-container-initramfs.sh "--cmdline=${MKRUNTIME_CMDLINE}"
# Exact generation-bound storage helpers intentionally outlive a control-plane
# restart and are authenticated/adopted by the next daemon instance.
KillMode=process
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
# /etc/systemd/system/mknetd.service -> /etc/multikernel/deployments/6182145c5cef6f7ebc12546387a65572656eb204c99e0f3d42534f6189b4380a/systemd/mknetd.service
[Unit]
Description=Multikernel primary-owned CNI control plane
Wants=network-online.target
After=network-online.target
Before=containerd.service docker.service

[Service]
Type=simple
EnvironmentFile=/etc/multikernel/runtime.env
ExecStart=/usr/local/sbin/mknetd --socket=/run/mknetd.sock --state-dir=/var/lib/mknetd --subnet=${MKNETWORK_SUBNET} --egress=${MKNETWORK_EGRESS} --mtu=${MKNETWORK_MTU} --allowed-uid=0 "--dns=${MKNETWORK_DNS}"
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
OBSERVATION_END key=units
