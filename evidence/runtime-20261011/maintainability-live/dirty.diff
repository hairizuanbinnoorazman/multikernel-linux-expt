-func (k *outputFIFOKeeper) Close() error {
-	if k == nil {
-		return nil
-	}
-	k.once.Do(func() {
-		_, signalErr := k.control.Write([]byte{1})
-		controlErr := k.control.Close()
-		guardErr := k.guard.Close()
-		waitErr := k.command.Wait()
-		k.err = errors.Join(signalErr, controlErr, guardErr, waitErr)
-	})
-	return k.err
-}
