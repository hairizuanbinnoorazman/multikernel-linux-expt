# Install as /etc/multikernel/runtime.env after adapting paths and the APIC IDs
# to the qualified host. Never include cloud credentials in this file.
# Kerf, socket, state, kernel-manifest, timeout, and host-headroom policy live
# in the strict root-owned /etc/mkruntime/config.json contract.
MKRUNTIME_POOL_CPUS=8,10,12,14,9,11,13,15
MKRUNTIME_POOL_MEMORY=16GB
MKRUNTIME_POOL_MEMORY_RESERVE=1GB
MKRUNTIME_CMDLINE="rdinit=/init console=mktty0 panic=-1"
MKRUNTIME_STORAGE_MOUNT=/srv/multikernel-storage
MKRUNTIME_STORAGE_DEVICE=/dev/disk/by-id/google-mk-mediated-storage-20260830
MKRUNTIME_STORAGE_SERIAL=mk-mediated-storage-20260830
MKRUNTIME_STORAGE_BYTES=21474836480
MKRUNTIME_STORAGE_LABEL=mk-mediated-host
MKRUNTIME_STORAGE_UUID=507c0523-8e58-4ae3-9524-3b7513aad344
MKNETWORK_SUBNET=172.31.0.0/24
# Set this to the qualified host's default-route interface (for example ens4).
MKNETWORK_EGRESS=ens4
MKNETWORK_MTU=1400
# Use the qualified primary resolver policy; comma-separate multiple addresses.
MKNETWORK_DNS=169.254.169.254
