# Install as /etc/multikernel/runtime.env after adapting paths and the APIC IDs
# to the qualified host. Never include cloud credentials in this file.
MKRUNTIME_KERF=/opt/kerf/.venv/bin/kerf
MKRUNTIME_BACKEND_TIMEOUT=90s
MKRUNTIME_POOL_CPUS=8,10,12,14,9,11,13,15
MKRUNTIME_POOL_MEMORY=16GB
MKRUNTIME_KERNEL=/opt/multikernel/vmlinux
MKRUNTIME_CMDLINE="rdinit=/init console=mktty0 panic=-1"
